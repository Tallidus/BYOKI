# HMAC secret for anonymous demo session cookies. Required.
SESSION_SECRET=

# 1 (default when unset) uses mock adapters and makes no provider calls.
# 0 sends the visitor's key to OpenAI, Anthropic, or Gemini. Keep 1 on the public site.
BYOKI_USE_MOCK=1

# memory (default) keeps demo keys in the Node process until the session ends.
# file uses the encrypted development store and needs BYOKI_MASTER_KEY. Do not use file on the public site.
BYOKI_STORE=memory

# 32-byte base64 or hex. Required only when BYOKI_STORE=file, or when you call
# createAIConnectionsApp without your own stores.
BYOKI_MASTER_KEY=

# Anonymous session lifetime in seconds. Default 7200. Clamped to 300–86400.
BYOKI_SESSION_TTL_SECONDS=7200

# Extra hostnames allowed for proxy redirects, comma-separated.
# byoki.eastonnielson.dev and localhost are always allowed.
BYOKI_PUBLIC_HOST=

# Absolute origin for metadata. Defaults to https://byoki.eastonnielson.dev.
BYOKI_PUBLIC_ORIGIN=https://byoki.eastonnielson.dev

# Opt-in provider smoke tests only. The demo site does not read these.
BYOKI_LIVE=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
