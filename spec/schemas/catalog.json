{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tallidus/BYOKI/blob/main/spec/schemas/catalog.json",
  "title": "BYOKI catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["updatedAt", "models"],
  "properties": {
    "updatedAt": { "type": "string", "minLength": 1 },
    "models": {
      "type": "array",
      "items": { "$ref": "#/$defs/model" }
    }
  },
  "$defs": {
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "provider", "displayName", "capabilities"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "provider": { "enum": ["openai", "anthropic", "gemini"] },
        "displayName": { "type": "string", "minLength": 1 },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["chat", "vision"] }
        }
      }
    }
  }
}
